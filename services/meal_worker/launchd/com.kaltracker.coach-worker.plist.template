<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Servizio dedicato alla SOLA coda del coach.

     ATTENZIONE: e' un'ALTERNATIVA al servizio unico, non un'aggiunta. Il plist
     com.kaltracker.meal-worker.plist.template gira con
     KAL_MEAL_WORKER_SCOPE=all, che dalla migrazione 0008 in poi serve tutte e
     tre le code: caricare entrambi i servizi con l'impostazione predefinita
     significherebbe due processi che si contendono gli stessi job. Il claim e'
     atomico (FOR UPDATE SKIP LOCKED), quindi non si corrompe niente, ma si
     avrebbero due Claude accesi insieme sullo stesso abbonamento senza nessun
     guadagno.

     Serve in un caso solo: tenere il coach separato dalle altre due code, per
     esempio per dargli log propri o per fermarlo da solo. In quel caso l'altro
     servizio va portato a KAL_MEAL_WORKER_SCOPE=meal_analysis,meal_planning —
     che oggi non esiste come valore: si sceglie uno dei due, oppure si
     caricano tre servizi, uno per ambito. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kaltracker.coach-worker</string>

  <key>ProgramArguments</key>
  <array>
    <string>__VENV_PATH__/bin/kal-meal-worker</string>
    <string>serve</string>
    <string>--scope</string>
    <string>coaching</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__MEAL_WORKER_DIRECTORY__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd non eredita il PATH della shell: la CLI claude installata via
         npm o Homebrew va resa raggiungibile. __CLAUDE_BIN_DIRECTORY__ e' la
         directory che contiene l'eseguibile claude, per esempio
         /opt/homebrew/bin oppure /Users/NOME/.nvm/versions/node/vXX/bin
         (la stessa directory di __CLAUDE_EXECUTABLE_ABSOLUTE_PATH__). -->
    <key>PATH</key>
    <string>__CLAUDE_BIN_DIRECTORY__:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>KAL_SUPABASE_URL</key>
    <string>https://__PROJECT_REF__.supabase.co</string>
    <key>KAL_SUPABASE_PUBLISHABLE_KEY</key>
    <string>__PUBLISHABLE_KEY__</string>
    <key>KAL_MEAL_WORKER_EMAIL</key>
    <string>__WORKER_EMAIL__</string>
    <key>KAL_MEAL_WORKER_KEYCHAIN_SERVICE</key>
    <string>com.kaltracker.meal-worker.supabase</string>
    <!-- Lo stesso utente worker e la stessa password nel Portachiavi delle
         altre code: cambia solo l'ambito servito. Sul database serve pero' la
         riga automation_bindings con scope 'coaching', altrimenti ogni RPC
         risponde 42501 (`kal-meal-worker doctor` lo dice). -->
    <key>KAL_MEAL_WORKER_SCOPE</key>
    <string>coaching</string>
    <!-- Il commento lo scrive solo Claude, come il piano: con provider codex
         questo servizio si rifiuta di partire. -->
    <key>KAL_MEAL_ANALYZER_PROVIDER</key>
    <string>claude</string>
    <key>KAL_CLAUDE_EXECUTABLE</key>
    <string>__CLAUDE_EXECUTABLE_ABSOLUTE_PATH__</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <!-- Riavvio automatico con throttle: launchd attende almeno 15 secondi tra
       un'uscita e il riavvio successivo, cosi un errore di configurazione non
       genera un loop stretto. -->
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>15</integer>
  <!-- Alla richiesta di stop launchd invia SIGTERM (gestito dal worker) e
       attende fino a 30 secondi prima del SIGKILL. -->
  <key>ExitTimeOut</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Background</string>

  <!-- Log dedicati del servizio: creare prima la directory
       (mkdir -p __LOG_DIRECTORY__). Nei log compaiono solo ID job e codici
       stabili: mai il commento, mai i numeri del rapporto, mai segreti. -->
  <key>StandardOutPath</key>
  <string>__LOG_DIRECTORY__/coach-worker.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIRECTORY__/coach-worker.err.log</string>
</dict>
</plist>
