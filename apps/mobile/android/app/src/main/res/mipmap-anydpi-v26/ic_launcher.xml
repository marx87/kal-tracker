<?xml version="1.0" encoding="utf-8"?>
<!-- Icona adattiva (Android 8 in su). Il fondo è un colore pieno e non
     un'immagine: il launcher lo ritaglia con la maschera che vuole — cerchio,
     goccia, quadrato smussato — e un colore non si deforma mai.

     Il livello <monochrome> serve alle icone a tema di Android 13: il sistema
     ne usa solo l'alfa e ci mette il proprio colore, quindi è lo stesso segno
     in nero pieno. Le versioni precedenti ignorano il tag. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
